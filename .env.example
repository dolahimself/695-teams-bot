# ---- Teams bot registration (Teams Developer Portal > Tools > Bot management, or Azure Bot) ----
MicrosoftAppId=
MicrosoftAppType=SingleTenant
MicrosoftAppTenantId=
MicrosoftAppPassword=
PORT=3978
# The public https address of this server (your dev tunnel). Needed for the Add Photos and recording dialogs, and the card's icons.
PUBLIC_BASE_URL=https://your-tunnel-name.devtunnels.ms

# ---- Where stories go: file | graph | flow ----
STORE=file

# STORE=graph  (writes to the SharePoint list through Microsoft Graph)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=
# Optional: document library for photos/audio/video (drive id). Leave empty to skip file upload.
SHAREPOINT_DRIVE_ID=

# STORE=flow  (posts JSON to a Power Automate flow URL; the HTTP trigger can be a premium connector)
FLOW_URL=

# Program choices shown in the chat, comma separated (placeholders: replace with the real programs)
PROGRAMS=Camp,Family support,Youth programs,Community events,Season of Sharing,Grocery vouchers,My own story as a Social Worker,My own story working with the agency,Other

# ---- Voice: record an answer instead of typing it (Azure AI Speech) ----
# Create a Speech resource in a Canadian region (for example canadacentral) so recordings are processed in Canada.
# Leave empty to hide the microphone buttons in Teams.
SPEECH_KEY=
SPEECH_REGION=canadacentral
# Language(s) people may speak, comma separated. More than one turns on language detection.
SPEECH_LOCALES=en-CA
