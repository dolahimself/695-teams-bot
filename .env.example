# ---- Teams bot registration (Teams Developer Portal > Tools > Bot management, or Azure Bot) ----
MicrosoftAppId=
MicrosoftAppType=SingleTenant
MicrosoftAppTenantId=
MicrosoftAppPassword=
PORT=3978
# The public https address of this server (your dev tunnel). Needed for the photo and video upload dialog.
PUBLIC_BASE_URL=https://your-tunnel-name.devtunnels.ms

# ---- Where stories go: file | graph | flow ----
STORE=file

# STORE=graph  (writes to the SharePoint list through Microsoft Graph)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=
# Optional: document library for photos/audio/video (drive id). Leave empty to skip file upload.
SHAREPOINT_DRIVE_ID=

# STORE=flow  (posts JSON to a Power Automate flow URL; the HTTP trigger can be a premium connector)
FLOW_URL=

# Program choices shown in the chat, comma separated (placeholders: replace with the real programs)
PROGRAMS=Camp,Family support,Youth programs,Community events,Other
