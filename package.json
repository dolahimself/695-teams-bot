{
  "name": "bear-friends-desk-bot",
  "version": "0.1.0",
  "description": "Bear Friends Desk: a Microsoft Teams bot that lets workers share a short, anonymous story in about two minutes. Stories land in a private SharePoint list for review.",
  "private": true,
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/index.js",
    "local": "npm run build && node dist/src/local.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "package": "node scripts/package.js",
    "preview": "npm run build && node dist/src/preview-server.js"
  },
  "dependencies": {
    "botbuilder": "^4.23.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "adm-zip": "^0.5.14",
    "typescript": "^5.5.0",
    "adaptivecards": "^2.11.3"
  }
}
