{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "0.1.0",
  "id": "{{BOT_ID}}",
  "developer": {
    "name": "Team Fusion55 (UX695)",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": { "short": "Bear Friends Stories", "full": "Bear Friends Stories: share a story" },
  "description": {
    "short": "Share a short, anonymous story in about two minutes.",
    "full": "Workers share a short story about a child or family through a quick chat. Stories go to a private list and are reviewed before anything is used. Prototype for the CFSGE Foundation."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#E8923A",
  "bots": [
    {
      "botId": "{{BOT_ID}}",
      "scopes": ["personal"],
      "supportsFiles": true,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            { "title": "Share a story", "description": "Start a new story" },
            { "title": "Cancel", "description": "Stop without saving" }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["{{DOMAIN}}"]
}
